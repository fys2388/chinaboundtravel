{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{{- $excludePaths := .Site.Params.sitemapExclude | default slice -}}
{{- $baseURL := "https://www.chinaboundtravel.com" -}}
{{- range .Data.Pages -}}
{{- $pagePath := .RelPermalink -}}
{{- $shouldExclude := false -}}
{{- /* Exclude paths from sitemapExclude config */ -}}
{{- range $excludePaths -}}
{{- $excludePath := . -}}
{{- if or (strings.HasPrefix $pagePath (printf "/%s/" $excludePath)) (strings.HasPrefix $pagePath (printf "/%s" $excludePath)) -}}
{{- $shouldExclude = true -}}
{{- end -}}
{{- end -}}
{{- /* Exclude tag pages — they are low-value taxonomy pages that dilute crawl budget */ -}}
{{- if strings.HasPrefix $pagePath "/tags/" -}}
{{- $shouldExclude = true -}}
{{- end -}}
{{- if and (not $shouldExclude) (not .Draft) -}}
<url>
  <loc>{{- $baseURL }}{{- replace .RelPermalink "//" "/" | safeHTML -}}</loc>
  {{- if .Lastmod }}
  <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05Z" | safeHTML }}</lastmod>
  {{- end }}
  {{- if .IsHome }}
  <priority>1.0</priority>
  <changefreq>daily</changefreq>
  {{- else if .IsPage }}
  <priority>0.8</priority>
  <changefreq>weekly</changefreq>
  {{- else if strings.HasPrefix $pagePath "/posts/" }}
  <priority>0.7</priority>
  <changefreq>weekly</changefreq>
  {{- else }}
  <priority>0.5</priority>
  <changefreq>monthly</changefreq>
  {{- end }}
</url>
{{- end -}}
{{- end -}}
</urlset>