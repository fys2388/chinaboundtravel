{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{{- $excludePaths := .Site.Params.sitemapExclude | default slice -}}
{{- range .Data.Pages -}}
{{- $pagePath := .RelPermalink -}}
{{- $shouldExclude := false -}}
{{- range $excludePaths -}}
{{- $excludePath := . -}}
{{- if or (strings.HasPrefix $pagePath (printf "/%s/" $excludePath)) (strings.HasPrefix $pagePath (printf "/%s" $excludePath)) -}}
{{- $shouldExclude = true -}}
{{- end -}}
{{- end -}}
{{- if and (not $shouldExclude) (not .Draft) -}}
<url>
  <loc>{{- if .Params.canonicalURL -}} {{ trim .Params.canonicalURL " " }} {{- else -}} {{ .Permalink }}{{- end -}}</loc>
  {{- if .Lastmod }}
  <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05Z" | safeHTML }}</lastmod>
  {{- end }}
  {{- if .IsHome }}
  <priority>1.0</priority>
  <changefreq>daily</changefreq>
  {{- else if .IsPage }}
  <priority>0.8</priority>
  <changefreq>weekly</changefreq>
  {{- else if or (strings.HasPrefix $pagePath "/posts/") (strings.HasPrefix $pagePath "/tags/") }}
  <priority>0.7</priority>
  <changefreq>weekly</changefreq>
  {{- else }}
  <priority>0.5</priority>
  <changefreq>monthly</changefreq>
  {{- end }}
</url>
{{- end -}}
{{- end -}}
</urlset>