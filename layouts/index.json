{{- /*
  覆盖 themes/PaperMod/layouts/index.json —— 内建版只过滤 searchHidden /
  archives / search 三种情况，完全不读 site.Params.sitemapExclude，于是
  success / cancel / ebook 等交易页与表单页全部混进站内搜索索引。

  实测（2026-09-20 线上 /index.json，83 条）：
    /success/  Payment Successful!
    /cancel/   Payment Cancelled
    /ebook/    ChinaBound Travel Guide 2026.08  （且标题重复 2 次）
  客户搜「visa」时看到 30 条结果，其中约 1/3 是无关内容。

  这里让搜索索引遵守 sitemapExclude，与 sitemap 口径一致。

  两个坑，都踩过：
  1. 内层 range 会把 . 换成排除项字符串，必须先 $page := . 保存页面，
     否则报 "can't evaluate field RelPermalink in type interface {}"。
  2. RelPermalink 带前导斜杠（/success/），而 sitemapExclude 里的值是
     "success" 不带斜杠。必须先 TrimPrefix "/"，否则 hasPrefix 永远不命中。
*/ -}}
{{- $.Scratch.Add "index" slice -}}
{{- $excl := site.Params.sitemapExclude | default slice -}}
{{- range site.RegularPages -}}
    {{- $page := . -}}
    {{- $rel := strings.TrimPrefix "/" $page.RelPermalink -}}
    {{- $skip := or $page.Params.searchHidden (eq $page.Layout "archives") (eq $page.Layout "search") -}}
    {{- range $e := $excl -}}
        {{- if and $e (hasPrefix $rel $e) -}}
            {{- $skip = true -}}
        {{- end -}}
    {{- end -}}
    {{- if not $skip -}}
        {{- $.Scratch.Add "index" (dict "title" $page.Title "content" $page.Plain "permalink" $page.Permalink "summary" $page.Summary) -}}
    {{- end -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
