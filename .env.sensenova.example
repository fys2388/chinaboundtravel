# ============================================================
# SenseNova LLM API 配置示例
# 使用方法:
#   1. 复制本文件: cp .env.sensenova.example .env.sensenova
#   2. 前往 https://platform.sensenova.cn/console/keys 创建 API Key
#   3. 将 SENSENOVA_API_KEY 替换为你的 Key
#   4. 在项目根目录加载: set -a; source .env.sensenova; set +a
# ============================================================

# SenseNova API Key (必填)
SENSENOVA_API_KEY=sk-your-key-here

# LLM 启用开关 (1=启用, 0=禁用)
LLM_ENABLED=1

# 默认提供商: sensenova / deepseek / openai
LLM_DEFAULT_PROVIDER=sensenova

# SenseNova 模型 (可选, 默认 sensenova-6.8-flash-lite)
# 可用模型:
#   sensenova-6.8-flash-lite  - 轻量多模态智能体
#   sensenova-u1.5-lite       - 图像生成与编辑
SENSENOVA_MODEL=sensenova-6.8-flash-lite

# 每日调用限额 (避免超额, 默认 200)
LLM_DAILY_LIMIT=200

# --- DeepSeek (备用提供商) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- OpenAI (备用提供商) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
