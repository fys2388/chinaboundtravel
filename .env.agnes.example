# ============================================================
# Agnes AI 文生图 API 配置
# 使用方法:
#   1. 复制本文件: cp .env.agnes.example .env.agnes
#   2. 前往 https://platform.agnes-ai.com/settings/apiKeys 创建 API Key
#   3. 将 AGNES_API_KEY 替换为你的 Key
#   4. 在项目根目录加载: set -a; source .env.agnes; set +a
# ============================================================

# Agnes AI API Key (必填，用于文生图)
AGNES_API_KEY=sk-your-key-here

# 启用生图开关 (1=启用, 0=禁用)
IMAGE_GEN_ENABLED=1

# Agnes AI 模型 (可选, 默认 agnes-image-2.5-flash)
# 可用模型:
#   agnes-image-2.0-flash  - 基础版
#   agnes-image-2.1-flash  - 增强版
#   agnes-image-2.5-flash  - 最新版本（推荐）
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
