/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block
  Access-Control-Allow-Origin: https://www.chinaboundtravel.com
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://emrldtp.com https://giscus.app https://static.cloudflareinsights.com https://pagead2.googlesyndication.com https://*.googlesyndication.com; style-src 'self' 'unsafe-inline' https://emrldtp.com; img-src 'self' data: https://www.google-analytics.com https://emrldtp.com https://*.googlesyndication.com https://*.googleusercontent.com https://pagead2.googlesyndication.com; font-src 'self' data:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https://stats.g.doubleclick.net https://api.github.com https://emrldtp.com https://sentry.io https://*.sentry.io https://sentry.avs.io https://pagead2.googlesyndication.com https://cloudflareinsights.com https://*.cloudflareinsights.com; frame-src https://giscus.app https://www.youtube.com https://player.vimeo.com https://emrldtp.com https://*.googlesyndication.com; object-src 'none'; base-uri 'self'; form-action 'self' https://formspree.io; frame-ancestors 'self'; upgrade-insecure-requests
  Cache-Control: public, s-maxage=3600

# Cache static assets (more specific than /*)
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images (more specific than /*)
/images/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=31536000, immutable
/generated_images/*
  Cache-Control: public, max-age=31536000, immutable

# Cache CSS/JS with content hash (more specific than /*)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache downloads / lead magnets (more specific than /*)
/ebook/*
  Cache-Control: public, max-age=31536000, immutable
/downloads/*
  Cache-Control: public, max-age=31536000, immutable
/lead-magnet/*
  Cache-Control: public, max-age=31536000, immutable

# XML sitemaps (more specific than /*)
/sitemap.xml
  Cache-Control: public, max-age=3600

# RSS feed (more specific than /*)
/index.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/rss+xml; charset=utf-8
