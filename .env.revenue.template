# ============================================================
# 营收数据收集配置模板
# 复制此文件为 .env.revenue 并填入真实凭证
# ============================================================

# GA4 Data API 配置
# 1. 在 Google Cloud Console 创建项目
# 2. 启用 Google Analytics Data API
# 3. 创建 Service Account，下载 JSON 密钥
# 4. 在 GA4 管理后台将 Service Account 邮箱添加为属性用户
GA4_PROPERTY_ID=G-GECBME3YVJ
GA4_CREDENTIALS_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"YOUR_KEY_ID","private_key":"YOUR_PRIVATE_KEY","client_email":"YOUR_CLIENT_EMAIL","client_id":"YOUR_CLIENT_ID","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"YOUR_CERT_URL"}

# Stripe API 配置
# 在 Stripe Dashboard → Developers → API keys 获取 Secret key
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY

# Travelpayouts API 配置
# 在 Travelpayouts 后台 → API 获取 token 和 marker
TRAVELPAYOUTS_API_TOKEN=YOUR_TRAVELPAYOUTS_API_TOKEN
TRAVELPAYOUTS_MARKER=YOUR_MARKER_ID

# Cloudflare Analytics API 配置（可选）
# 在 Cloudflare Dashboard → My Profile → API Tokens 创建
CF_API_TOKEN=YOUR_CF_API_TOKEN
CF_ZONE_ID=YOUR_CF_ZONE_ID
